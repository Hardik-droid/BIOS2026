FROM node:22-bookworm-slim AS frontend
WORKDIR /build
COPY web/package.json web/package-lock.json web/.npmrc ./web/
WORKDIR /build/web
RUN npm ci --no-audit --no-fund
WORKDIR /build
COPY . .
WORKDIR /build/web
RUN npm run build:cloud

FROM golang:1.27.3-bookworm AS server
WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=frontend /build/dist ./dist
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath \
    -ldflags="-s -w -X main.Version=railway" -o /out/diwan .

FROM alpine:3.22
RUN apk add --no-cache ca-certificates su-exec \
    && adduser -D -u 10001 diwan \
    && mkdir -p /var/lib/diwan
COPY --from=server /out/diwan /usr/local/bin/diwan
COPY scripts/railway-entrypoint.sh /usr/local/bin/diwan-entrypoint
RUN chmod 755 /usr/local/bin/diwan-entrypoint
WORKDIR /var/lib/diwan
ENV GIN_MODE=release
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/diwan-entrypoint"]
